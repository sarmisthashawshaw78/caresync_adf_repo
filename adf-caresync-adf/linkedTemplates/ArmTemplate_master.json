{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-adf"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1009-134334-ylnkrpuj"
		},
		"LinkedSrPostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-soft-poetry-b3ehsamu-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"LinkedSrPostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LinkedSrPostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LinkedSr_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncusecase.dfs.core.windows.net/"
		},
		"LinkedSr_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-keyvaults.vault.azure.net/"
		},
		"LinkedSr_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-trial-server.database.windows.net"
		},
		"LinkedSr_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"LinkedSr_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sarmistha"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LinkedSr_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LinkedSr_ADLS_properties_typeProperties_url')]"
					},
					"LinkedSr_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LinkedSr_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"LinkedSrPostgreSql_properties_typeProperties_server": {
						"value": "[parameters('LinkedSrPostgreSql_properties_typeProperties_server')]"
					},
					"LinkedSrPostgreSql_properties_typeProperties_database": {
						"value": "[parameters('LinkedSrPostgreSql_properties_typeProperties_database')]"
					},
					"LinkedSrPostgreSql_properties_typeProperties_username": {
						"value": "[parameters('LinkedSrPostgreSql_properties_typeProperties_username')]"
					},
					"LinkedSr_AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('LinkedSr_AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"LinkedSr_AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('LinkedSr_AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"LinkedSr_AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('LinkedSr_AzureSqlDatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}